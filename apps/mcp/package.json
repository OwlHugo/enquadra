{
  "name": "enquadra-mcp",
  "version": "0.1.0",
  "description": "MCP server for Enquadra: CST and cClassTrib (IBS/CBS) for Brazilian products, with the article of LC 214/2025 behind each one.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OwlHugo/enquadra.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://github.com/OwlHugo/enquadra#readme",
  "keywords": [
    "mcp",
    "ibs",
    "cbs",
    "cclasstrib",
    "nfe",
    "reforma-tributaria",
    "lc-214"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "data"
  ],
  "bin": {
    "enquadra-mcp": "./dist/main.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm build && node ../../scripts/bundle-table.ts mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7",
    "ai": "7.0.143",
    "@ai-sdk/google": "4.0.99"
  },
  "devDependencies": {
    "@enquadra/domain": "workspace:*",
    "@enquadra/sources": "workspace:*",
    "@enquadra/ai": "workspace:*"
  }
}
