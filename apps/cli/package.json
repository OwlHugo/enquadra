{
  "name": "enquadra",
  "version": "0.1.0",
  "description": "Classifies a catalog or NF-e XML into IBS/CBS CST and cClassTrib, with the legal basis.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OwlHugo/enquadra.git",
    "directory": "apps/cli"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm build && node ../../scripts/bundle-table.ts"
  },
  "dependencies": {
    "ai": "7.0.143",
    "@ai-sdk/google": "4.0.99",
    "zod": "4.6.7",
    "fast-xml-parser": "5.11.2"
  },
  "bin": {
    "enquadra": "./dist/main.mjs"
  },
  "devDependencies": {
    "@enquadra/domain": "workspace:*",
    "@enquadra/sources": "workspace:*",
    "@enquadra/nfe": "workspace:*",
    "@enquadra/ai": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ibs",
    "cbs",
    "cclasstrib",
    "reforma-tributaria",
    "nfe",
    "nfse",
    "cli"
  ],
  "homepage": "https://github.com/OwlHugo/enquadra#readme"
}
