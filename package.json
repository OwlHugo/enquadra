{
  "name": "enquadra-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "lint": "biome check .",
    "format": "biome check --write .",
    "architecture": "node scripts/architecture.ts",
    "knip": "knip",
    "sources:update": "node scripts/update-sources.ts",
    "sources:check": "node scripts/update-sources.ts --check",
    "eval": "node --conditions=development evals/run.ts",
    "eval:sem-ia": "node --conditions=development evals/run.ts --no-ai",
    "enquadra": "node --conditions=development apps/cli/src/main.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm architecture && pnpm test:coverage && pnpm eval:sem-ia"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "knip": "6.42.0",
    "tsdown": "0.23.1",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
