{
  "name": "enquadra-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage.enabled",
    "lint": "biome check .",
    "format": "biome check --write .",
    "arquitetura": "node scripts/arquitetura.ts",
    "knip": "knip",
    "fontes": "node scripts/atualizar-fontes.ts",
    "fontes:checar": "node scripts/atualizar-fontes.ts --checar",
    "eval": "node --conditions=development evals/rodar.ts",
    "eval:sem-ia": "node --conditions=development evals/rodar.ts --sem-ia",
    "enquadra": "node --conditions=development apps/cli/src/main.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm arquitetura && pnpm test:cobertura && pnpm eval:sem-ia"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "knip": "6.42.0",
    "tsdown": "0.23.1",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
